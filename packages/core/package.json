{
  "name": "@coraza-openapi/core",
  "version": "0.1.0",
  "description": "Generate Coraza WAF rules from an OpenAPI specification (core library).",
  "license": "Apache-2.0",
  "author": "Juan Pablo Tosso <pablo@owasp.org>",
  "contributors": ["OWASP Coraza contributors"],
  "homepage": "https://github.com/coraza-incubator/coraza-openapi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coraza-incubator/coraza-openapi.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/coraza-incubator/coraza-openapi/issues",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./samples": {
      "types": "./dist/samples/index.d.ts",
      "import": "./dist/samples/index.js"
    }
  },
  "files": ["dist", "src/samples", "LICENSE", "NOTICE", "README.md"],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "openapi-types": "^12.1.3",
    "swagger2openapi": "^7.0.8",
    "yaml": "^2.8.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/swagger2openapi": "^7.0.4"
  }
}
