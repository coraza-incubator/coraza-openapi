{
  "name": "coraza-openapi-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Generate Coraza WAF rules from an OpenAPI specification.",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/web",
    "packages/cli"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build -w @coraza-openapi/core && npm run build -w @coraza-openapi/web && npm run build -w coraza-openapi",
    "build:core": "npm run build -w @coraza-openapi/core",
    "build:web": "npm run build -w @coraza-openapi/web",
    "build:cli": "npm run build -w coraza-openapi",
    "dev": "npm run dev -w @coraza-openapi/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:coraza": "cd tests/coraza-e2e && go test -v -count=1 ./...",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.59.0",
    "vitest": "^4.1.5"
  }
}
